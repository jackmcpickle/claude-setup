{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8317",
    "ANTHROPIC_AUTH_TOKEN": "<your Arbor API key: see ARBOR_API_KEY in ~/.secrets>",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(make :*)",
      "Bash(docker :*)",
      "Bash(echo :*)",
      "Bash(grep :*)",
      "Bash(uv run :*)",
      "Bash(python:*)",
      "Bash(uv run python:*)",
      "Bash(timeout 3 uv run:*)",
      "Bash(make migrations:*)",
      "Bash(ls:*)",
      "Bash(uv pip:*)",
      "WebSearch",
      "Bash(xargs cat:*)",
      "Bash(uv run celery:*)",
      "Bash(docker compose build:*)",
      "Bash(pnpm install)",
      "Bash(docker compose run:*)",
      "Bash(docker compose:*)",
      "Bash(cat :*)",
      "Bash(curl :*)",
      "Bash(find :*)",
      "Bash(docker exec :*)",
      "Bash(pnpm :*)",
      "Bash(pnpx :*)",
      "Bash(pnpm storybook:*)"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "agent-browser": "off",
    "astro-web": "off",
    "bro": "off",
    "elite-bootstrap": "off",
    "elite-deploy": "off",
    "elite-qa": "off",
    "elite-style": "off",
    "elite-validate": "off",
    "hono-api": "off",
    "loop-me": "off",
    "poteto-mode": "off",
    "react-doctor": "off",
    "show-me": "off",
    "teach": "off",
    "to-questionnaire": "off",
    "triage": "off",
    "wait-what": "off",
    "wayfinder": "off",
    "why": "off"
  },
  "disableBundledSkills": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil release $CLAUDE_CODE_SESSION_ID --tool claude-code"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run-ai-dev-insights.sh\"",
            "timeout": 8
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-hook.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tokenmaxer claude-sessionend",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run-ai-dev-insights.sh\"",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil release $CLAUDE_CODE_SESSION_ID --tool claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tokenmaxer claude-sessionstart",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run-ai-dev-insights.sh\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil acquire $CLAUDE_CODE_SESSION_ID --tool claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run-ai-dev-insights.sh\"",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil release $CLAUDE_CODE_SESSION_ID --tool claude-code"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run-ai-dev-insights.sh\"",
            "timeout": 8
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run-ai-dev-insights.sh\"",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil acquire --tool claude-code --subagent"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run-ai-dev-insights.sh\"",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil release --tool claude-code --subagent"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/run-ai-dev-insights.sh\"",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil acquire $CLAUDE_CODE_SESSION_ID --tool claude-code"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "aikido@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "cowork-plugin-management@synced": false,
    "employment-legal@synced": false,
    "feature-dev@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "ip-legal@synced": false,
    "legal@synced": false,
    "marketing@synced": false,
    "playwright@claude-plugins-official": true,
    "product-legal@synced": false,
    "pyright-lsp@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "stripe@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "neon-postgres@neon": true,
    "cloudflare@claude-plugins-official": true
  },
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 200000
    }
  },
  "autoCompactWindow": 200000,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true
}
